<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Dark -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#1C1C1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#252528" />
    <SolidColorBrush x:Key="CardBrush" Color="#2C2C30" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#333338" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#2C2C30" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4CC2FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7AD8FF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C7C7CC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#34C759" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD60A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="DownloadChartStroke" Color="#4CC2FF" />
    <SolidColorBrush x:Key="UploadChartStroke" Color="#FF7AC3" />

    <SolidColorBrush x:Key="GlassFillBrush" Color="#2C2C30" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#3A3A40" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#333338" />
    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#252528" />
    <SolidColorBrush x:Key="GlassChartBrush" Color="#252528" />

</ResourceDictionary>

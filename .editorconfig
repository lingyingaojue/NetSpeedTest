root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{md,json,xml,xaml,html,css,js}]
indent_size = 2

# CI 配置按 LF 存储（与 .gitattributes 的 *.yml eol=lf 保持一致）
[*.{yml,yaml}]
indent_size = 2
end_of_line = lf

[*.md]
trim_trailing_whitespace = false

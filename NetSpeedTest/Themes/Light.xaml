<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Light -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F3F3F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFCFE" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#EEEEF2" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E3E3E8" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="#F0F0F4" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#106EBE" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1E" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#55555C" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E8E93" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#248A3D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#B58900" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#D70015" />
    <SolidColorBrush x:Key="DownloadChartStroke" Color="#0078D4" />
    <SolidColorBrush x:Key="UploadChartStroke" Color="#D63384" />

    <SolidColorBrush x:Key="GlassFillBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#E3E3E8" />
    <SolidColorBrush x:Key="GlassHighlightBrush" Color="#EEEEF2" />
    <SolidColorBrush x:Key="GlassSidebarBrush" Color="#FCFCFE" />
    <SolidColorBrush x:Key="GlassChartBrush" Color="#FCFCFE" />

</ResourceDictionary>

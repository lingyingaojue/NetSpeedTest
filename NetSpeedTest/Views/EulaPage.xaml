<UserControl x:Class="NetSpeedTest.Views.EulaPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="用户协议与声明（已同意）" FontSize="13"
                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding EulaText}" FontSize="11"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap" LineHeight="18" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="撤销同意并退出" Width="130"
                    Style="{StaticResource DangerButtonStyle}" Click="Revoke_Click" />
            <Button Content="关闭" Width="60" Margin="12,0,0,0"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</UserControl>

<Window x:Class="NetSpeedTest.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:converters="clr-namespace:NetSpeedTest.Converters"
        Title="NetSpeedTest" Height="720" Width="1280" MinHeight="563" MinWidth="1000"
        Icon="/Resources/app.png"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BackgroundBrush}"
        ResizeMode="CanResize">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="8" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding StartDownloadTestCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelTestCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding StartDownloadTestCommand}" />
        <KeyBinding Key="U" Modifiers="Ctrl" Command="{Binding StartUploadTestCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding StartFullTestCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <converters:RateDisplayConverter x:Key="RateDisplayConverter" />
        <converters:BytesDisplayConverter x:Key="BytesDisplayConverter" />
        <converters:DurationDisplayConverter x:Key="DurationDisplayConverter" />
        <converters:LatencyDisplayConverter x:Key="LatencyDisplayConverter" />
        <converters:BoolInverterConverter x:Key="BoolInverter" />
        <converters:NotNullConverter x:Key="NotNullConverter" />
        <converters:SpeedDisplayConverter x:Key="SpeedDisplayConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧导航栏（纯文字） ===== -->
        <Border Grid.Column="0" Background="{DynamicResource GlassSidebarBrush}">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="NetSpeedTest" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="20,14,20,22" />
                    <Button Content="测速" Style="{StaticResource SidebarItemStyle}"
                            Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"
                            Command="{Binding ClosePageCommand}" />
                    <Button Content="历史记录" Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0"
                            Command="{Binding OpenHistoryCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                    <Button Content="配置管理" Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0"
                            Command="{Binding OpenProfileConfigCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                    <Button Content="设置" Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0"
                            Command="{Binding OpenSettingsCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                    <Button Content="更多功能" Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0"
                            Command="{Binding OpenMoreCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,12">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="16,0,16,10" />
                    <Button Content="用户协议" Style="{StaticResource SidebarItemStyle}"
                            Command="{Binding OpenEulaCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                    <Button Content="关于" Style="{StaticResource SidebarItemStyle}" Margin="0,4,0,0"
                            Command="{Binding OpenAboutCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 右侧主内容 ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 自绘标题栏（Win 风格） ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="NetSpeedTest" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="配置" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="16,0,6,0" VerticalAlignment="Center" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,8,0"
                           TextTrimming="CharacterEllipsis" />

                <Button Grid.Column="3" Content="─" FontSize="14" Width="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MinimizeBtn_Click" ToolTip="最小化" />
                <Button Grid.Column="4" Content="□" FontSize="13" Width="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="MaximizeBtn_Click" ToolTip="最大化/还原" />
                <Button Grid.Column="5" Content="✕" FontSize="14" Width="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="CloseBtn_Click" ToolTip="关闭">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- ===== 主内容区（页面 / 测速主视图） ===== -->
            <Grid Grid.Row="1" Margin="16,8,16,16">

                <!-- 页面内容（侧边栏打开时显示） -->
                <ContentControl Content="{Binding CurrentPage}"
                                Visibility="{Binding CurrentPage, Converter={StaticResource NotNullConverter}}" />

                <!-- 测速主视图（双状态） -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage, Converter={StaticResource NotNullConverter}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                <!-- 空闲态：3 个大测速按钮 -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTesting}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="选择测速模式" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,28" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="下载测速" Style="{StaticResource HeroButtonStyle}"
                                    Command="{Binding StartDownloadTestCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                            <Button Content="上传测速" Style="{StaticResource HeroButtonStyle}" Margin="16,0,0,0"
                                    Command="{Binding StartUploadTestCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                            <Button Content="双向测速" Style="{StaticResource HeroButtonStyle}" Margin="16,0,0,0"
                                    Command="{Binding StartFullTestCommand}"
                                    IsEnabled="{Binding IsTesting, Converter={StaticResource BoolInverter}}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 最近结果 -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,16,0,0"
                            Visibility="{Binding DownloadMbps, Converter={StaticResource NotNullConverter}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="最近结果：" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{StaticResource DownloadChartStroke}">
                                <Run Text="▼ " /><Run Text="{Binding DownloadMbps, Converter={StaticResource RateDisplayConverter}}" />
                            </TextBlock>
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource UploadChartStroke}">
                                <Run Text="▲ " /><Run Text="{Binding UploadMbps, Converter={StaticResource RateDisplayConverter}}" />
                            </TextBlock>
                            <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource SuccessBrush}">
                                <Run Text="{Binding LatencyMs, Converter={StaticResource LatencyDisplayConverter}}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 测试态：指标 + 双图表 + 网卡 + 操作 -->
                <Grid Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 大号实时指标 -->
                    <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="下载速率" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource DownloadChartStroke}" HorizontalAlignment="Center">
                                <Run Text="▼ " /><Run Text="{Binding DownloadMbps, Converter={StaticResource RateDisplayConverter}}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="上传速率" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource UploadChartStroke}" HorizontalAlignment="Center">
                                <Run Text="▲ " /><Run Text="{Binding UploadMbps, Converter={StaticResource RateDisplayConverter}}" />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="内网延迟" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LatencyMs, Converter={StaticResource LatencyDisplayConverter}}"
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="抖动延迟" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="JitterText" Text="--" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="外网延迟" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding WanLatencyMs, Converter={StaticResource LatencyDisplayConverter}}"
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="总流量" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesDisplayConverter}}"
                                       FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- 双图表 -->
                    <Grid Grid.Row="1" x:Name="ChartGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="DlCol" Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition x:Name="UlCol" Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GlassChartCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="下载速率" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource DownloadChartStroke}" Margin="0,0,0,8" />
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding DownloadChartSeries}"
                                                    XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                                    TooltipPosition="Top" />
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" Width="4" Background="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Stretch" />

                        <Border Grid.Column="2" Style="{StaticResource GlassChartCardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="上传速率" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource UploadChartStroke}" Margin="0,0,0,8" />
                                <lvc:CartesianChart Grid.Row="1" Series="{Binding UploadChartSeries}"
                                                    XAxes="{Binding XAxes}" YAxes="{Binding YAxes}"
                                                    TooltipPosition="Top" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 网卡实时速率条 -->
                    <ScrollViewer Grid.Row="2" x:Name="AdapterScrollViewer" Margin="0,8,0,0"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnHorizontalMouseWheel">
                        <ItemsControl ItemsSource="{Binding AllAdapterRates}" MinHeight="36">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource GlassFillBrush}" CornerRadius="4"
                                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                            Padding="8,4" Margin="4,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="200"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource DownloadChartStroke}"
                                                       VerticalAlignment="Center">
                                                <Run Text="▼ " />
                                                <Run Text="{Binding DownloadMbps, Converter={StaticResource RateDisplayConverter}}" />
                                            </TextBlock>
                                            <TextBlock FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource UploadChartStroke}"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <Run Text="▲ " />
                                                <Run Text="{Binding UploadMbps, Converter={StaticResource RateDisplayConverter}}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 操作行 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12">
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveThreadCount, StringFormat=活跃线程 {0}}" FontSize="12"
                                       Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                        </Border>
                        <Button Content="取消" Width="80" Margin="16,0,0,0" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding CancelTestCommand}" />
                        <Button Content="导出" Width="70" Margin="8,0,0,0"
                                Command="{Binding ExportResultCommand}" />
                    </StackPanel>

                    <!-- 网卡详细信息（折叠） -->
                    <Expander Grid.Row="4" Header="网卡详细信息" FontSize="13"
                              Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Adapters}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource GlassFillBrush}" CornerRadius="6"
                                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                            Padding="10,8" Margin="0,0,0,6">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#2EA043" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="已断开">
                                                                    <Setter Property="Fill" Value="#DA3633" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Background="{StaticResource AccentBrush}" CornerRadius="4"
                                                        Padding="6,2" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding TypeName}" FontSize="12" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <Border Background="{StaticResource AccentBrush}" CornerRadius="4"
                                                        Padding="6,2" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding LinkSpeedBps, Converter={StaticResource SpeedDisplayConverter}}"
                                                               FontSize="12" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <UniformGrid Columns="3">
                                                <StackPanel>
                                                    <TextBlock Text="IP 地址" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding IPAddress, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DownloadChartStroke}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="默认网关" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Gateway, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource SuccessBrush}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="子网掩码" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding SubnetMask, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="MAC 地址" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding MacAddress, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource WarningBrush}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="IPv6 地址" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding IPv6Address, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="DNS 服务器" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding DnsServers, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource UploadChartStroke}" TextWrapping="Wrap" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="DHCP 服务器" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding DhcpServer, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DownloadChartStroke}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="MTU" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding Mtu, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="连接状态" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StatusText}" Value="已断开">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>

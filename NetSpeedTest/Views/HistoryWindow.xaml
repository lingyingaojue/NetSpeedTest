<UserControl x:Class="NetSpeedTest.Views.HistoryPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NetSpeedTest.Converters">
    <UserControl.Resources>
        <converters:RateDisplayConverter x:Key="RateDisplayConverter" />
        <converters:BytesDisplayConverter x:Key="BytesDisplayConverter" />
        <converters:DurationDisplayConverter x:Key="DurationDisplayConverter" />
        <converters:LatencyDisplayConverter x:Key="LatencyDisplayConverter" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ======== 统计栏 ======== -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,8" Padding="10,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="共 "/><Run Text="{Binding Stats.TotalCount}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/><Run Text=" 次"/>
                </TextBlock>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="最快下载 "/><Run Text="{Binding Stats.MaxDownloadMbps, Converter={StaticResource RateDisplayConverter}}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                </TextBlock>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="最快上传 "/><Run Text="{Binding Stats.MaxUploadMbps, Converter={StaticResource RateDisplayConverter}}" Foreground="{DynamicResource SuccessBrush}" FontWeight="Bold"/>
                </TextBlock>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="平均下载 "/><Run Text="{Binding Stats.AvgDownloadMbps, Converter={StaticResource RateDisplayConverter}}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                </TextBlock>
                <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                <TextBlock FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="最低延迟 "/><Run Text="{Binding Stats.MinLatencyMs, Converter={StaticResource LatencyDisplayConverter}}" Foreground="{DynamicResource WarningBrush}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ======== 历史记录表格 ======== -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding Records}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectedItem="{Binding SelectedRecord}"
                  MouseDoubleClick="DataGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="测速时间" Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                    Width="140" />
                <DataGridTextColumn Header="类型" Binding="{Binding TestType}" Width="45" />
                <DataGridTextColumn Header="配置" Binding="{Binding NodeName}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="线程" Binding="{Binding ThreadCount}" Width="40" />
                <DataGridTextColumn Header="下载平均" Binding="{Binding DownloadMbps, Converter={StaticResource RateDisplayConverter}}"
                                    Width="90" />
                <DataGridTextColumn Header="上传平均" Binding="{Binding UploadMbps, Converter={StaticResource RateDisplayConverter}}"
                                    Width="90" />
                <DataGridTextColumn Header="内网平均延迟" Binding="{Binding LatencyMs, Converter={StaticResource LatencyDisplayConverter}}"
                                    Width="70" />
                <DataGridTextColumn Header="外网平均延迟" Binding="{Binding WanLatencyMs, Converter={StaticResource LatencyDisplayConverter}}"
                                    Width="70" />
                <DataGridTextColumn Header="{DynamicResource Hist_Loss}" Binding="{Binding PacketLoss, StringFormat={}{0:F1}%}" Width="60" />
                <DataGridTextColumn Header="总均速" Binding="{Binding AverageTotalMbps, Converter={StaticResource RateDisplayConverter}}"
                                    Width="90" />
                <DataGridTextColumn Header="总流量" Binding="{Binding TotalBytes, Converter={StaticResource BytesDisplayConverter}}"
                                    Width="85" />
                <DataGridTextColumn Header="耗时" Binding="{Binding DurationSeconds, Converter={StaticResource DurationDisplayConverter}}"
                                    Width="80" />
                <DataGridTextColumn Header="网卡" Binding="{Binding NetworkAdapterName}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ======== 底部分页栏 ======== -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="{DynamicResource Hist_Prev}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding CanGoPrevious}"
                        Width="70" />

                <TextBlock Grid.Column="1" Text="{Binding PageNumber, StringFormat='第 {0} 页'}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13" VerticalAlignment="Center" Margin="16,0" />

                <TextBlock Grid.Column="2" Text="{Binding TotalPages, StringFormat='/ 共 {0} 页'}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />

                <Button Grid.Column="3" Content="{DynamicResource Hist_Next}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Width="70" />

                <Button Grid.Column="4" Content="{DynamicResource Hist_Clear}" Width="90" Margin="12,0,0,0"
                        Command="{Binding ClearAllRecordsCommand}"
                        Background="{DynamicResource ErrorBrush}"
                        Foreground="{DynamicResource BackgroundBrush}" />

                <Button Grid.Column="5" Content="{DynamicResource Hist_Export}" Width="90" Margin="12,0,0,0"
                        Command="{Binding ExportCsvCommand}"
                        Background="{DynamicResource AccentHoverBrush}"
                        Foreground="{DynamicResource BackgroundBrush}" />

                <Button Grid.Column="6" Content="{DynamicResource Hist_Delete}"
                        Command="{Binding DeleteRecordCommand}"
                        Background="{DynamicResource ErrorBrush}"
                        Foreground="{DynamicResource BackgroundBrush}"
                        Width="90" Margin="12,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

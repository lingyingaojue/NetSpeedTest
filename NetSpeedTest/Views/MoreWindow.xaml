<UserControl x:Class="NetSpeedTest.Views.MorePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NetSpeedTest.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:BoolInverterConverter x:Key="BoolInverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SurfaceBrush}">
                <ListBox ItemsSource="{Binding Tabs}"
                         SelectedIndex="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0"
                         FontSize="13" Foreground="{StaticResource TextPrimaryBrush}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="16,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{StaticResource CardBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
        </Border>

        <Border Background="{StaticResource BorderBrush}" Grid.Column="1"/>

        <!-- ===== Right Content: 17 Panels ===== -->
        <Grid Grid.Column="2" Margin="24,16,24,16">
        <Grid.Resources>
            <Style x:Key="PanelStyle" TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
            <Style x:Key="ResultBoxStyle" TargetType="TextBox">
                <Setter Property="Margin" Value="0,12,0,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </Grid.Resources>

        <!-- 0: Ping 工具 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="目标地址" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="70" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock Text="次数" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PingCount, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="开始 Ping" Width="90" Margin="16,0,0,0" Command="{Binding StartPingCommand}" IsEnabled="{Binding IsPinging, Converter={StaticResource BoolInverter}}"/>
                <TextBlock Text="Ping 中..." FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsPinging, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding PingResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 1: DNS 查询 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="域名" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="50" VerticalAlignment="Center"/>
                <TextBox Text="{Binding DnsHost, UpdateSourceTrigger=PropertyChanged}" Width="220" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="查询" Width="70" Margin="12,0,0,0" Command="{Binding StartDnsCommand}" IsEnabled="{Binding IsResolving, Converter={StaticResource BoolInverter}}"/>
                <TextBlock Text="查询中..." FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsResolving, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding DnsResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 2: HTTP -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="URL" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" VerticalAlignment="Center"/>
                <TextBox Text="{Binding HttpUrl, UpdateSourceTrigger=PropertyChanged}" Width="400" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="测速" Width="70" Margin="12,0,0,0" Command="{Binding StartHttpCommand}" IsEnabled="{Binding IsHttpTesting, Converter={StaticResource BoolInverter}}"/>
                <TextBlock Text="测速中..." FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsHttpTesting, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding HttpResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 3: 路由追踪 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="目标地址" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="70" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TraceHost, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="开始追踪" Width="90" Margin="12,0,0,0" Command="{Binding StartTraceCommand}" IsEnabled="{Binding IsTracing, Converter={StaticResource BoolInverter}}"/>
                <TextBlock Text="追踪中..." FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsTracing, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding TraceResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 4: 端口测试 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="主机" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PortHost, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock Text="端口" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="60" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="测试" Width="70" Margin="12,0,0,0" Command="{Binding StartPortCommand}" IsEnabled="{Binding IsPortTesting, Converter={StaticResource BoolInverter}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding PortResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 5: MTU -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="目标地址" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="70" VerticalAlignment="Center"/>
                <TextBox Text="{Binding MtuHost, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="开始探测" Width="90" Margin="12,0,0,0" Command="{Binding StartMtuCommand}" IsEnabled="{Binding IsMtuProbing, Converter={StaticResource BoolInverter}}"/>
                <TextBlock Text="探测中..." FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsMtuProbing, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding MtuResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 6: DNS 对比 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="6"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="域名" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="50" VerticalAlignment="Center"/>
                <TextBox Text="{Binding DnsCompHost, UpdateSourceTrigger=PropertyChanged}" Width="200" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="对比延迟" Width="90" Margin="12,0,0,0" Command="{Binding StartDnsCompCommand}" IsEnabled="{Binding IsDnsComparing, Converter={StaticResource BoolInverter}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding DnsCompResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 7: IP 归属 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="7"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="IP 地址" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="60" VerticalAlignment="Center"/>
                <TextBox Text="{Binding GeoIp, UpdateSourceTrigger=PropertyChanged}" Width="180" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="查询" Width="70" Margin="12,0,0,0" Command="{Binding StartGeoCommand}" IsEnabled="{Binding IsGeoQuerying, Converter={StaticResource BoolInverter}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding GeoResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 8: 公网 IP -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="8"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="多源验证您当前的公网 IPv4 地址" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <Button Content="查询公网 IP" Width="110" Margin="16,0,0,0" Command="{Binding CheckPublicIpCommand}" IsEnabled="{Binding IsCheckingPublicIp, Converter={StaticResource BoolInverter}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding PublicIpResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 9: SSL 证书 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="9"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="域名" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="50" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SslHost, UpdateSourceTrigger=PropertyChanged}" Width="200" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="查看证书" Width="90" Margin="12,0,0,0" Command="{Binding CheckSslCommand}" IsEnabled="{Binding IsSslChecking, Converter={StaticResource BoolInverter}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding SslResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 10: HTTP Header -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="10"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="URL" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" VerticalAlignment="Center"/>
                <TextBox Text="{Binding HeaderUrl, UpdateSourceTrigger=PropertyChanged}" Width="400" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="查看 Header" Width="100" Margin="12,0,0,0" Command="{Binding CheckHeadersCommand}" IsEnabled="{Binding IsHeaderChecking, Converter={StaticResource BoolInverter}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding HeaderResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 11: 子网计算 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="11"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="IP 地址" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="60" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SubnetIp, UpdateSourceTrigger=PropertyChanged}" Width="140" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <TextBlock Text="掩码" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" Margin="12,0,0,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding SubnetMask, UpdateSourceTrigger=PropertyChanged}" Width="140" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="计算" Width="60" Margin="12,0,0,0" Command="{Binding CalcSubnetCommand}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding SubnetResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 12: 带宽换算 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="12"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="Mbps" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="50" VerticalAlignment="Center"/>
                <TextBox Text="{Binding BwMbps, UpdateSourceTrigger=PropertyChanged}" Width="80" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="换算" Width="60" Margin="12,0,0,0" Command="{Binding CalcBandwidthCommand}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding BwResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 13: 时间戳 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="13"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="时间戳" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="60" VerticalAlignment="Center"/>
                <TextBox Text="{Binding TsInput, UpdateSourceTrigger=PropertyChanged}" Width="220" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="转换" Width="60" Margin="12,0,0,0" Command="{Binding ConvertTimestampCommand}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding TsResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 14: 文本哈希 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="14"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox Grid.Row="0" Text="{Binding HashInput, UpdateSourceTrigger=PropertyChanged}" Height="60"
                     FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrush}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>
            <Button Grid.Row="1" Content="计算哈希" Width="90" Margin="0,8,0,0" Command="{Binding CalcHashCommand}"/>
            <TextBox Grid.Row="2" Text="{Binding HashResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 15: Base64 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="15"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBox Grid.Row="0" Text="{Binding B64Input, UpdateSourceTrigger=PropertyChanged}" Height="60"
                     FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}"
                     BorderBrush="{StaticResource BorderBrush}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>
            <Button Grid.Row="1" Content="编码 / 解码" Width="110" Margin="0,8,0,0" Command="{Binding EncodeBase64Command}"/>
            <TextBox Grid.Row="2" Text="{Binding B64Result}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 16: UUID 生成 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="16"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="数量" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Width="40" VerticalAlignment="Center"/>
                <TextBox Text="{Binding UuidCount, UpdateSourceTrigger=PropertyChanged}" Width="50" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="生成" Width="60" Margin="12,0,0,0" Command="{Binding GenUuidCommand}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding UuidResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>

        <!-- 17: NAT 检测 -->
        <Grid Grid.Row="0">
            <Grid.Style><Style TargetType="Grid" BasedOn="{StaticResource PanelStyle}"><Style.Triggers><DataTrigger Binding="{Binding SelectedTab}" Value="17"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <WrapPanel Margin="0,0,0,8">
                <TextBlock Text="STUN 检测 NAT 类型（RFC 5389）" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="自定义" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Width="45" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <TextBox Text="{Binding CustomStunServer, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"/>
                <Button Content="开始检测" Width="90" Margin="12,0,0,0" Command="{Binding DetectNatCommand}" IsEnabled="{Binding IsNatDetecting, Converter={StaticResource BoolInverter}}"/>
                <TextBlock Text="检测中..." FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="8,0,0,0" Visibility="{Binding IsNatDetecting, Converter={StaticResource BoolToVisibility}}"/>
            </WrapPanel>
            <TextBox Grid.Row="1" Text="{Binding NatResult}" Style="{StaticResource ResultBoxStyle}"/>
        </Grid>
    </Grid>
    </Grid>
</UserControl>

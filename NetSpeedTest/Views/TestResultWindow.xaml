<Window x:Class="NetSpeedTest.Views.TestResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测速完成" Width="640" Height="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Resources/app.png"
        Background="{DynamicResource BackgroundBrush}">
    <StackPanel Margin="24,20,24,24">
        <TextBlock Text="{DynamicResource Res_Title}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,14" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_Duration}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ElapsedValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="DownloadRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_Download}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="DlValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource DownloadChartStroke}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="UploadRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_Upload}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="UlValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource UploadChartStroke}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel x:Name="TotalAvgRow" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_TotalAvg}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TotalAvgValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_TotalTraffic}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TotalBytesValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_Lan}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="LanValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="{DynamicResource Res_Jitter}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="JitterValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Res_Wan}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="WanValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Res_PacketLoss}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Width="130" TextAlignment="Right" Margin="0,0,16,0" VerticalAlignment="Center" />
            <TextBlock x:Name="PacketLossValue" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <Border x:Name="NicResultsPanel" Background="{DynamicResource GlassFillBrush}" CornerRadius="6"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                Padding="8,6" Margin="0,0,0,10" Visibility="Collapsed">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NicResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding NetworkAdapterName}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="140" />
                                <TextBlock Text="{Binding DownloadMbps, StringFormat={}{0:F1} Mbps, TargetNullValue=--}"
                                           FontSize="12" Foreground="{DynamicResource DownloadChartStroke}" MinWidth="100" />
                                <TextBlock Text="{Binding UploadMbps, StringFormat={}{0:F1} Mbps, TargetNullValue=--}"
                                           FontSize="12" Foreground="{DynamicResource UploadChartStroke}" MinWidth="100" />
                                <TextBlock Text="{Binding ErrorMessage, TargetNullValue=''}"
                                           FontSize="12" Foreground="{DynamicResource ErrorBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
            <Button Content="{DynamicResource Copy}" Width="80" Click="Copy_Click" />
            <Button Content="{DynamicResource Export}" Width="80" Margin="8,0,0,0" Click="Export_Click" />
            <Button Content="{DynamicResource OK}" Width="80" Margin="8,0,0,0"
                    Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>

<Window x:Class="NetSpeedTest.Views.TestResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测速完成" Width="720" Height="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Resources/app.png"
        Background="{DynamicResource BackgroundBrush}">
    <Window.Resources>
        <Style x:Key="ResultRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style x:Key="ResultLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Width" Value="110" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <Style x:Key="ResultValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24" HorizontalAlignment="Center">
        <TextBlock Text="{DynamicResource Res_Title}" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />

        <StackPanel Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_Duration}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="ElapsedValue" Style="{StaticResource ResultValueStyle}" />
        </StackPanel>

        <StackPanel x:Name="DownloadRow" Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_Download}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="DlValue" Style="{StaticResource ResultValueStyle}"
                       Foreground="{DynamicResource DownloadChartStroke}" />
        </StackPanel>

        <StackPanel x:Name="UploadRow" Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_Upload}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="UlValue" Style="{StaticResource ResultValueStyle}"
                       Foreground="{DynamicResource UploadChartStroke}" />
        </StackPanel>

        <StackPanel x:Name="TotalAvgRow" Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_TotalAvg}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="TotalAvgValue" Style="{StaticResource ResultValueStyle}"
                       Foreground="{DynamicResource SuccessBrush}" />
        </StackPanel>

        <StackPanel Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_TotalTraffic}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="TotalBytesValue" Style="{StaticResource ResultValueStyle}" />
        </StackPanel>

        <StackPanel Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_Lan}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="LanValue" Style="{StaticResource ResultValueStyle}" />
        </StackPanel>

        <StackPanel Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_Jitter}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="JitterValue" Style="{StaticResource ResultValueStyle}" />
        </StackPanel>

        <StackPanel Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_Wan}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="WanValue" Style="{StaticResource ResultValueStyle}" />
        </StackPanel>

        <StackPanel Style="{StaticResource ResultRowStyle}">
            <TextBlock Text="{DynamicResource Res_PacketLoss}" Style="{StaticResource ResultLabelStyle}" />
            <TextBlock x:Name="PacketLossValue" Style="{StaticResource ResultValueStyle}" />
        </StackPanel>

        <Border x:Name="NicResultsPanel" Background="{DynamicResource GlassFillBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                Padding="10,8" Margin="0,14,0,10" Visibility="Collapsed">
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="NicResultsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Text="{Binding NetworkAdapterName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Width="130"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding NetworkAdapterName}" />
                                <TextBlock Text="{Binding DownloadMbps, StringFormat={}{0:F1} Mbps, TargetNullValue=--}"
                                           FontSize="14" Foreground="{DynamicResource DownloadChartStroke}" Width="92" />
                                <TextBlock Text="{Binding UploadMbps, StringFormat={}{0:F1} Mbps, TargetNullValue=--}"
                                           FontSize="14" Foreground="{DynamicResource UploadChartStroke}" Width="92" />
                                <TextBlock Text="{Binding LatencyMs, StringFormat={}{0:F0} ms, TargetNullValue=--}"
                                           FontSize="14" Foreground="{DynamicResource SuccessBrush}" Width="70" />
                                <TextBlock Text="{Binding WanLatencyMs, StringFormat={}{0:F0} ms, TargetNullValue=--}"
                                           FontSize="14" Foreground="{DynamicResource WarningBrush}" Width="70" />
                                <TextBlock Text="{Binding JitterMs, StringFormat={}{0:F1} ms, TargetNullValue=--}"
                                           FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" Width="70" />
                                <TextBlock Text="{Binding ErrorMessage, TargetNullValue=''}"
                                           FontSize="14" Foreground="{DynamicResource ErrorBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="{DynamicResource Copy}" MinWidth="80" Click="Copy_Click" />
            <Button Content="{DynamicResource Export}" MinWidth="80" Margin="8,0,0,0" Click="Export_Click" />
            <Button Content="{DynamicResource OK}" MinWidth="80" Margin="8,0,0,0"
                    Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
        </StackPanel>
    </StackPanel>
</Window>
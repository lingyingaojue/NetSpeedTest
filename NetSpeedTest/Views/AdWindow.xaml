<Window x:Class="NetSpeedTest.Views.AdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="840" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        WindowStyle="ToolWindow"
        Background="{StaticResource BackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource AccentBrush}"
                    CornerRadius="10" Padding="14,5"
                    HorizontalAlignment="Center" Margin="0,0,0,16" Grid.ColumnSpan="2">
                <TextBlock Text="赞助商广告" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource BackgroundBrush}" />
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="#000000" />
                </Border.Effect>
                <Image x:Name="AdImage" MaxHeight="600" Stretch="Uniform"
                       HorizontalAlignment="Center" />
            </Border>

            <StackPanel Grid.Row="1" Grid.Column="1" Margin="28,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="SponsorNameText" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,14" TextWrapping="Wrap" TextAlignment="Left" />

                <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14" />

                <TextBlock x:Name="SponsorDetailText" FontSize="16" LineHeight="28"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,0,0,24" TextAlignment="Left" TextWrapping="Wrap" />

                <Button Content="关闭" Width="90" FontSize="14" HorizontalAlignment="Right"
                        Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>

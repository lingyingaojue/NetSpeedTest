<UserControl x:Class="NetSpeedTest.Views.WebServerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center">

                <!-- 标题 -->
                <TextBlock Text="{DynamicResource WebServer_Title}" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{DynamicResource WebServer_Desc}" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,10,0,0" />

                <!-- 开关卡 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,20,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WebServer_Control}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <CheckBox Content="{DynamicResource WebServer_Enable}" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,14,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="{DynamicResource WebServer_Status}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" Margin="10,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding StatusText}" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Content="{DynamicResource WebServer_LanEnable}" IsChecked="{Binding AllowLanAccess, Mode=TwoWay}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" Margin="0,12,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="端口" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox SelectedIndex="{Binding PortModeIndex, Mode=TwoWay}" Width="150" Margin="10,0,0,0">
                                <ComboBoxItem Content="自动选择空闲端口" />
                                <ComboBoxItem Content="自定义端口" />
                            </ComboBox>
                            <TextBox Text="{Binding CustomPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"
                                     Margin="8,0,0,0" VerticalContentAlignment="Center" />
                            <Button Content="应用" Width="70" Margin="8,0,0,0"
                                    Command="{Binding ApplyPortCommand}" />
                            <TextBlock Text="{Binding CurrentPort, StringFormat=当前端口: {0}}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{DynamicResource WebServer_LanStatus}" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                            <Ellipse Width="8" Height="8" Margin="10,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AllowLanAccess}" Value="False">
                                                <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding LanReady}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding LanStatusText}" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 访问地址卡 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource WebServer_Address}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <Border Background="{DynamicResource GlassFillBrush}" CornerRadius="8"
                                    BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                    Padding="12,8" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Url, Mode=OneWay}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button Content="{DynamicResource WebServer_Open}" Width="120"
                                    Command="{Binding OpenBrowserCommand}"
                                    IsEnabled="{Binding Enabled}" />
                            <Button Content="{DynamicResource WebServer_Copy}" Width="90" Margin="8,0,0,0"
                                    Command="{Binding CopyUrlCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 网卡网段映射卡 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="20,16">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource WebServer_CopyLan}" Width="130"
                                    Command="{Binding CopyLanAddressesCommand}" />
                            <TextBlock Text="{DynamicResource WebServer_LanAddresses}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{Binding LanStatusText}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <ItemsControl ItemsSource="{Binding LanSubnetGroups}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource GlassFillBrush}" CornerRadius="8"
                                            BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="1"
                                            Padding="12,10" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right"
                                                        Content="{DynamicResource WebServer_CopySubnet}"
                                                        MinWidth="96" Padding="8,2" Margin="8,0,0,0"
                                                        Command="{Binding DataContext.CopySubnetAddressesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                                <TextBlock Text="{Binding Subnet}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </DockPanel>

                                            <ItemsControl ItemsSource="{Binding Bindings}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock Text="{Binding AdapterName}" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DisplayText}" FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding Url}" FontSize="12"
                                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                                       Margin="12,0,0,0" MaxWidth="260" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding Url}" />
                                                            <Button Grid.Column="2" Content="{DynamicResource WebServer_CopyAddress}"
                                                                    MinWidth="56" Padding="8,2" Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.CopyLanAddressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{DynamicResource WebServer_LanNote}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- 网页文件卡 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WebServer_FileTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding WwwRootPath, Mode=OneWay}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="{DynamicResource WebServer_Note}" FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="{DynamicResource WebServer_OpenFolder}" Width="150" Margin="0,12,0,0"
                                HorizontalAlignment="Left" Command="{Binding OpenWwwRootCommand}" />
                    </StackPanel>
                </Border>

                <!-- API 卡 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource WebServer_ApiList}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <ItemsControl ItemsSource="{Binding ApiEndpoints}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 操作结果 -->
                <TextBlock Text="{Binding CopyResultText}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                           Margin="0,10,0,0" />

                <Button Content="{DynamicResource WebServer_Back}" Width="110" Margin="0,16,0,0"
                        HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding CloseCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

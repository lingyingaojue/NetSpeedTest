<UserControl x:Class="NetSpeedTest.Views.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NetSpeedTest.Converters">
    <UserControl.Resources>
        <converters:StringPrefixBrushConverter x:Key="PrefixBrush" />
    </UserControl.Resources>
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center">

                <!-- Hero -->
                <Image Source="/Resources/app.png" Width="120" Height="120"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="NetSpeedTest" FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="12,4">
                        <TextBlock Text="V1.3.7" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource BackgroundBrush}" />
                    </Border>
                    <Button Content="检查更新" Width="90" Margin="10,0,0,0"
                            Click="CheckUpdate_Click" />
                </StackPanel>
                <TextBlock Text="网络测速工具" FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock x:Name="UpdateResultText" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />

                <!-- 信息卡 -->
                <UniformGrid Columns="2" Margin="0,24,0,0">
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,6,6" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="开发者" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="凌影傲爵" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="6,0,0,6" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="AI 协作" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="DeepSeek" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,6,6,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="GitHub" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock FontSize="13" Margin="0,4,0,0">
                                <Hyperlink Click="GitHub_Click"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextDecorations="None">
                                    github.com/lingyingaojue/NetSpeedTest
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="6,6,0,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="联系方式" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock FontSize="13" Margin="0,4,0,0">
                                <Hyperlink Click="Email_Click"
                                           Foreground="{StaticResource AccentBrush}"
                                           TextDecorations="None">
                                    mashuo2010az@163.com
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 广告位 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="赞助商" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="SponsorNameText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="SponsorDetailText" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 更新日志 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="更新日志" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Changelog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,6,0,0" Padding="2,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}" FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Date}" FontSize="11"
                                                           Foreground="{StaticResource TextMutedBrush}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Details}" Margin="0,3,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="12"
                                                                   Foreground="{Binding Converter={StaticResource PrefixBrush}}"
                                                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button Content="返回测速" Width="90" Margin="0,16,0,0" HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

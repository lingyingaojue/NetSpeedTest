<UserControl x:Class="NetSpeedTest.Views.AboutPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NetSpeedTest.Converters">
    <UserControl.Resources>
        <converters:StringPrefixBrushConverter x:Key="PrefixBrush" />
    </UserControl.Resources>
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="640" HorizontalAlignment="Center">

                <!-- Hero -->
                <Image Source="/Resources/app.png" Width="120" Height="120"
                       HorizontalAlignment="Center" Margin="0,0,0,16" />
                <TextBlock Text="NetSpeedTest" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="12,4">
                        <TextBlock Text="V1.4.1" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource BackgroundBrush}" />
                    </Border>
                    <Button Content="{DynamicResource About_Check}" Width="90" Margin="10,0,0,0"
                            Click="CheckUpdate_Click" />
                </StackPanel>
                <TextBlock Text="{DynamicResource About_Desc}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                <TextBlock x:Name="UpdateResultText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />

                <!-- 信息卡 -->
                <UniformGrid Columns="2" Margin="0,24,0,0">
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,6,6" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About_Dev}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="凌影傲爵" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="6,0,0,6" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About_Collab}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock Text="DeepSeek" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="0,6,6,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="GitHub" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock FontSize="13" Margin="0,4,0,0">
                                <Hyperlink Click="GitHub_Click"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="None">
                                    https://github.com/lingyingaojue/NetSpeedTest
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource GlassCardStyle}" Margin="6,6,0,0" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource About_Website}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                            <TextBlock FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap">
                                <Hyperlink Click="Website_Click"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="None">
                                    https://lingyingaojue.github.io/NetSpeedTest/
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Contact}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock FontSize="13">
                                <Hyperlink Click="Email_Click"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="None">
                                    mashuo2010az@163.com
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="13" Margin="28,0,0,0">
                                <Hyperlink Click="WeChat_Click"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="None">
                                    <Run Text="{DynamicResource About_WeChat}" /><Run Text=" Smailboy2010" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="13" Margin="28,0,0,0">
                                <Hyperlink Click="Qq_Click"
                                           Foreground="{DynamicResource AccentBrush}"
                                           TextDecorations="None">
                                    <Run Text="{DynamicResource About_QQ}" /><Run Text=" Smailboy2010" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CopyResultText" FontSize="12" Foreground="{DynamicResource SuccessBrush}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />

                <!-- 广告位 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Sponsor}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock x:Name="SponsorNameText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0" />
                        <TextBlock x:Name="SponsorDetailText" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 更新日志 -->
                <Border Style="{StaticResource GlassCardStyle}" Margin="0,12,0,0" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource About_Changelog}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Changelog}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,6,0,0" Padding="2,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}" FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding Date}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Details}" Margin="0,3,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontSize="12"
                                                                   Foreground="{Binding Converter={StaticResource PrefixBrush}}"
                                                                   TextWrapping="Wrap" Margin="0,1,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Button Content="{DynamicResource About_Back}" Width="90" Margin="0,16,0,0" HorizontalAlignment="Center"
                        Style="{StaticResource AccentButtonStyle}" Click="Close_Click" />
            </StackPanel>
        </ScrollViewer>
        <Popup x:Name="CopyToast" Placement="Center" AllowsTransparency="True"
               PopupAnimation="Fade" StaysOpen="False" IsHitTestVisible="False">
            <Border Background="#E61F2937" CornerRadius="10" Padding="20,12">
                <TextBlock x:Name="CopyToastText" Foreground="White" FontSize="14" FontWeight="SemiBold" />
            </Border>
        </Popup>
    </Grid>
</UserControl>

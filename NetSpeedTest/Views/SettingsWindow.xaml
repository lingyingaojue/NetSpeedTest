<UserControl x:Class="NetSpeedTest.Views.SettingsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:NetSpeedTest.Converters"
        xml:lang="en-US">
    <UserControl.Resources>
        <converters:BoolInverterConverter x:Key="BoolInverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SurfaceBrush}" Grid.Row="0" Grid.RowSpan="2">
            <ListBox ItemsSource="{Binding Categories}"
                     SelectedIndex="{Binding SelectedCategoryIndex, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="14"
                     Foreground="{DynamicResource TextPrimaryBrush}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="20,14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{DynamicResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{DynamicResource CardBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Background="{DynamicResource BorderBrush}" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"/>

        <Grid Grid.Column="2" Grid.Row="0" Margin="28,20,28,0">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_Concurrency}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ThreadCount, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="2" Maximum="1024" Value="{Binding ThreadCount}"
                            IsSnapToTickEnabled="True" TickFrequency="2"
                            IsEnabled="{Binding AdaptiveThreadsEnabled, Converter={StaticResource BoolInverter}}"/>

                <CheckBox Content="{DynamicResource Set_AdaptiveMode}" IsChecked="{Binding AdaptiveThreadsEnabled}"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,12,0,0"/>
                <TextBlock Text="{DynamicResource Set_AdaptiveHint}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"
                           Visibility="{Binding AdaptiveThreadsEnabled, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap"/>

                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_Timeout}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TestTimeoutSec, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="10" Maximum="600" Value="{Binding TestTimeoutSec}"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_Ramp}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ThreadRampUpMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="2000" Value="{Binding ThreadRampUpMs}"
                            TickFrequency="100" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_AvgDelay}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AverageDelaySec, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="1" Maximum="30" Value="{Binding AverageDelaySec}"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_RateWindow}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RateWindowSec, StringFormat={}{0:F1}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0.5" Maximum="10" Value="{Binding RateWindowSec}"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_NicPoll}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding NicPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="200" Maximum="5000" Value="{Binding NicPollIntervalMs}"
                            TickFrequency="100" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_LatencyPoll}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LatencyPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="500" Maximum="10000" Value="{Binding LatencyPollIntervalMs}"
                            TickFrequency="500" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_JitterPoll}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding JitterPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="500" Maximum="5000" Value="{Binding JitterPollIntervalMs}"
                            TickFrequency="500" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_JitterHost}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding JitterTargetHost, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource BackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,12,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_PacketLossHost}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PacketLossTargetHost, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                 FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource BackgroundBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_PacketLossPoll}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PacketLossPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="500" Maximum="5000" Value="{Binding PacketLossPollIntervalMs}"
                            TickFrequency="500" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <CheckBox Content="{DynamicResource Set_CompEnable}" IsChecked="{Binding CompensationEnabled}"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,16"/>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_CompThreshold}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompensationThreshold, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0.3" Maximum="0.8" Value="{Binding CompensationThreshold}"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CompensationEnabled}"/>
                </StackPanel>


                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Set_CompConfirm}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompensationConfirmSec, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="1" Maximum="10" Value="{Binding CompensationConfirmSec}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CompensationEnabled}"/>
                </StackPanel>

            </StackPanel>
        </Grid>

        <!-- 分类 3：广告 -->
        <StackPanel Grid.Column="2" Grid.Row="0" Margin="28,20,28,0" VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="3">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="{DynamicResource Set_AdTitle}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Set_Sponsor}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding AdSponsorName}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="{DynamicResource Set_AdStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="{Binding AdStatusText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Content="{DynamicResource Set_CloseAd}" Width="130"
                    Command="{Binding CloseAdCommand}"/>
        </StackPanel>


        <!-- 分类 4：外观 -->
        <StackPanel Grid.Column="2" Grid.Row="0" Margin="28,20,28,0" VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="4">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <TextBlock Text="{DynamicResource Set_Appearance}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource Set_Theme}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                           Width="160" VerticalAlignment="Center"/>
                <ComboBox Width="160" ItemsSource="{Binding ThemeOptions}"
                          SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="{DynamicResource Set_Language}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                           Width="160" VerticalAlignment="Center"/>
                <ComboBox Width="160" ItemsSource="{Binding LanguageOptions}"
                          SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"/>
            </StackPanel>

        </StackPanel>
        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="28,16,28,20">
            <Button Content="{DynamicResource Save}" Width="80" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SaveCommand}"/>
            <Button Content="{DynamicResource Cancel}" Width="60" Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>

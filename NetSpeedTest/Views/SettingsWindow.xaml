<Window x:Class="NetSpeedTest.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="测速设置" Height="540" Width="960"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Resources/app.png"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource SurfaceBrush}" Grid.Row="0" Grid.RowSpan="2">
            <ListBox ItemsSource="{Binding Categories}"
                     SelectedIndex="{Binding SelectedCategoryIndex}"
                     Background="Transparent"
                     BorderThickness="0"
                     FontSize="14"
                     Foreground="{StaticResource TextPrimaryBrush}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="20,14"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border" Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{StaticResource AccentBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background"
                                                    Value="{StaticResource CardBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Background="{StaticResource BorderBrush}" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"/>

        <Grid Grid.Column="2" Grid.Row="0" Margin="28,20,28,0">
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="并发线程数" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ThreadCount, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="8" Value="{Binding ThreadIndex}"
                            IsSnapToTickEnabled="True" Ticks="0 1 2 3 4 5 6 7 8"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="测速时长 (秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TestTimeoutSec, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="10" Maximum="600" Value="{Binding TestTimeoutSec}"
                            TickFrequency="10" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="线程启动间隔 (毫秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ThreadRampUpMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="2000" Value="{Binding ThreadRampUpMs}"
                            TickFrequency="100" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="平均计量延迟 (秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AverageDelaySec, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="1" Maximum="30" Value="{Binding AverageDelaySec}"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="速率平滑窗口 (秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RateWindowSec, StringFormat={}{0:F1}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0.5" Maximum="10" Value="{Binding RateWindowSec}"
                            TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="网卡轮询间隔 (毫秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding NicPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="200" Maximum="5000" Value="{Binding NicPollIntervalMs}"
                            TickFrequency="100" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="延迟轮询间隔 (毫秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LatencyPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="500" Maximum="10000" Value="{Binding LatencyPollIntervalMs}"
                            TickFrequency="500" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="抖动采样间隔 (毫秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding JitterPollIntervalMs, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="500" Maximum="5000" Value="{Binding JitterPollIntervalMs}"
                            TickFrequency="500" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="抖动探测主机" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding JitterTargetHost, UpdateSourceTrigger=PropertyChanged}" Width="200"
                                 FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                 Background="{StaticResource BackgroundBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedCategoryIndex}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <CheckBox Content="启用补偿" IsChecked="{Binding CompensationEnabled}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,0,0,16"/>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="补偿阈值" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompensationThreshold, StringFormat={}{0:F2}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0.3" Maximum="0.8" Value="{Binding CompensationThreshold}"
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CompensationEnabled}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="补偿线程数" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompensationExtraThreads, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="0" Maximum="64" Value="{Binding CompensationExtraThreads}"
                            TickFrequency="4" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CompensationEnabled}"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="确认时长 (秒)" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                   Width="160" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CompensationConfirmSec, StringFormat={}{0}}" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" Width="50" TextAlignment="Right"/>
                    </StackPanel>
                    <Slider Minimum="1" Maximum="10" Value="{Binding CompensationConfirmSec}"
                            TickFrequency="1" IsSnapToTickEnabled="True"
                            IsEnabled="{Binding CompensationEnabled}"/>
                </StackPanel>

                <CheckBox Content="启用自适应线程上限" IsChecked="{Binding AdaptiveThreadsEnabled}" Margin="0,0,0,0"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="28,16,28,20">
            <Button Content="保存" Width="80" Style="{StaticResource AccentButtonStyle}"
                    Command="{Binding SaveCommand}"/>
            <Button Content="取消" Width="60" Margin="8,0,0,0"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Window>
